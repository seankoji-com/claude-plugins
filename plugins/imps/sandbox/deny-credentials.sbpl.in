;; deny-credentials.sbpl.in — terminal Seatbelt rules appended after safehouse's
;; generated policy (safehouse --append-profile emits appended files LAST, and
;; Seatbelt is last-match-wins, so these rules are authoritative).
;;
;; Rendered by scripts/sandbox-wrap.sh: every @HOME@ and @GITMETA@ token is
;; replaced with the real, canonical path. @REAL_GITDIR@ is the per-worktree
;; gitdir sandbox-wrap.sh resolves from --worktree itself (see its own
;; comment on REAL_GITDIR for why this is a `literal` path substitution, not
;; an escaped-for-regex one — an earlier version of this file used a `(regex
;; ...)` rule with the path escaped in bash first, verified live to fail open
;; when interpolated through a second `sed` pass). Not valid SBPL until
;; rendered — hence the .in suffix.
;;
;; Why each rule exists:
;;   /dev/null            git and opencode both write to it; without this the
;;                        sandboxed `git commit` dies with an obscure I/O error.
;;   .local/share/opencode  the REAL opencode data dir, holding auth.json. The
;;                        sandbox gets a redirected XDG_DATA_HOME with a copy;
;;                        the original must stay unreadable (§D of the harness
;;                        contract). safehouse denies this by default, but the
;;                        rule is restated here so the guarantee is explicit and
;;                        survives a safehouse default change.
;;   .ssh / .aws          never needed by this workload; a cheap `--auto` model
;;                        with network egress must not be able to read keys.
;;   .config/gh           safehouse GRANTS this by default (it is tuned for
;;                        general coding agents that drive `gh`). Not appropriate
;;                        here — this rule deliberately overrides that default.
;;   .claude/.credentials.json  Claude Code's own OAuth credentials.
;;   @GITMETA@/hooks, config, config.worktree, info/exclude
;;                        contract §A grants $GITMETA read-write so sandboxed
;;                        git plumbing (index, objects, refs) works — but for a
;;                        real dispatch, GITMETA is the linked worktree's SHARED
;;                        git common dir. opencode-dispatch.sh's own commit runs
;;                        OUTSIDE the sandbox with hooks live (see its
;;                        core.hooksPath note) — a model that writes
;;                        hooks/post-commit or sets core.fsmonitor in `config`
;;                        gets that script executed at full, unsandboxed
;;                        operator privilege the next time the harness (or
;;                        anyone else) touches this git dir. Independently
;;                        found and verified (live exploit reproduced) by two
;;                        separate reviewers.
;;
;;                        NOT SUFFICIENT ON ITS OWN: this denies writes to the
;;                        static config/hooks locations, but not the *pointer*
;;                        files that decide which config git actually reads —
;;                        the worktree's own `.git` file (necessarily writable;
;;                        it lives inside the granted worktree) can be
;;                        rewritten to redirect to a model-created fake gitdir,
;;                        also inside the worktree, with its own config and a
;;                        malicious core.fsmonitor or clean/smudge filter.
;;                        Reproduced live against exactly this deny list by a
;;                        third reviewer. opencode-dispatch.sh closes this by
;;                        snapshotting $WT/.git (and this gitdir's commondir,
;;                        gitdir, and HEAD files) before the model ever runs
;;                        and refusing to commit if any byte changed — see
;;                        GITMETA_POINTER_BASELINE there. This file's denies
;;                        remain useful defense in depth for the ordinary case
;;                        (a model editing gitmeta directly rather than via a
;;                        worktree-local redirect), but the pointer-snapshot
;;                        check in opencode-dispatch.sh is what actually closes
;;                        the boundary that matters most, not this file alone.
;;
;;   @GITMETA@/info/attributes, @GITMETA@/objects/info/alternates
;;                        Two more filter/attribute-triggering or
;;                        object-read-redirecting paths inside the read-write
;;                        $GITMETA grant, found in a third review round after
;;                        the entries above: info/attributes can carry a
;;                        `filter=` directive exactly like .gitattributes,
;;                        with the same unsandboxed-`git add -A` consequence;
;;                        objects/info/alternates lets a model point object
;;                        reads at an attacker-controlled object store outside
;;                        the sandbox's own grants.
;;
;;   @GITMETA@/worktrees (whole subtree denied, @REAL_GITDIR@ re-allowed,
;;   then @REAL_GITDIR@/{config.worktree,commondir,gitdir} re-denied)
;;                        For a REAL dispatch (always a linked worktree), git
;;                        reads config.worktree from the PER-WORKTREE gitdir
;;                        (@GITMETA@/worktrees/<name>/), not from @GITMETA@'s
;;                        own root — the entries above never cover it. A
;;                        fourth review round's first attempt at this denied
;;                        only THIS dispatch's own
;;                        @REAL_GITDIR@/config.worktree, verified live to miss
;;                        the actual remaining hole: $GITMETA is granted
;;                        read-write WHOLESALE, so a model in worktree A can
;;                        write worktree B's config.worktree, commondir, or
;;                        gitdir too — reproduced live as a full RCE against
;;                        the harness's own unsandboxed commit via a sibling
;;                        dispatch's worktree. /imps running several imps in
;;                        sibling worktrees off one repo is exactly this
;;                        shape. Denying the whole subtree and re-allowing
;;                        only the one gitdir THIS dispatch actually owns
;;                        closes every sibling path at once, not just this
;;                        run's own. opencode-dispatch.sh's pointer-snapshot
;;                        still catches tampering with THIS dispatch's own
;;                        pointers (it can't see poisoning done to a sibling's
;;                        gitdir from inside a different, earlier dispatch);
;;                        this rule is what closes the cross-dispatch case the
;;                        snapshot structurally cannot.

(allow file-write* (literal "/dev/null"))

(deny file-read* (subpath "@HOME@/.local/share/opencode")
                 (subpath "@HOME@/.ssh")
                 (subpath "@HOME@/.aws")
                 (subpath "@HOME@/.config/gh")
                 (literal "@HOME@/.claude/.credentials.json"))

(deny file-write* (subpath "@GITMETA@/hooks")
                  (literal "@GITMETA@/config")
                  (literal "@GITMETA@/config.worktree")
                  (literal "@GITMETA@/info/exclude")
                  (literal "@GITMETA@/info/attributes")
                  (literal "@GITMETA@/objects/info/alternates"))

;; Order is load-bearing (Seatbelt is last-match-wins): deny the whole
;; worktrees/ subtree first, re-allow only THIS dispatch's own gitdir next,
;; then re-deny its specific pointer files within that reallow — each line
;; must stay in exactly this sequence for the intended precedence to hold.
(deny  file-write* (subpath "@GITMETA@/worktrees"))
(allow file-write* (subpath "@REAL_GITDIR@"))
(deny  file-write* (literal "@REAL_GITDIR@/config.worktree")
                   (literal "@REAL_GITDIR@/commondir")
                   (literal "@REAL_GITDIR@/gitdir"))
