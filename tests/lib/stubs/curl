#!/usr/bin/env bash
# Deterministic stand-in for the real `curl` CLI. tests/run.sh prepends this
# stub's directory to PATH so scripts under test see fixed output instead of
# making live network calls.
#
# Only babysitter's list-prs.sh calls curl today, for the GraphQL round trip it
# moved off `gh api graphql` to route around a sandbox TLS-trust mismatch (see
# list-prs.sh's header comment). This stub understands exactly that call shape:
#   curl -sS -o <file> -w '%{http_code}' -H ... -X POST --data <json> <url>
# It writes a response body to -o's file and prints an HTTP status code to
# stdout, mirroring curl's own -w behavior.
set -euo pipefail

out_file=""
data=""
while [ $# -gt 0 ]; do
  case "$1" in
  -o)
    out_file="${2:-}"
    shift 2
    ;;
  --data)
    data="${2:-}"
    shift 2
    ;;
  *)
    shift
    ;;
  esac
done

[ -n "$out_file" ] || {
  echo "stub curl: missing -o" >&2
  exit 1
}
[ -n "$data" ] || {
  echo "stub curl: missing --data" >&2
  exit 1
}

q_val=$(printf '%s' "$data" | jq -r '.variables.q // empty')
pr_number=$(printf '%s' "$data" | jq -r '.variables.number // empty')

# babysitter list-prs.sh's own FAIL- convention (see tests/lib/stubs/gh's graphql
# branch): an org/repo qualifier starting with FAIL- simulates a failed query.
case "$q_val" in
org:FAIL-* | repo:FAIL-*)
  echo 'stub curl: GraphQL query failed (simulated error)' >"$out_file"
  echo "500"
  exit 0
  ;;
esac

if [ -n "$pr_number" ]; then
  # Single-PR form. #99 is MERGED, to pin that a finished PR is filtered out — the
  # single-PR query has no is:open qualifier to do it, and pr-events.sh
  # --exit-when-empty only terminates because it happens.
  pr_state="OPEN"
  [ "$pr_number" = "99" ] && pr_state="MERGED"
  cat >"$out_file" <<GRAPHQL_ONE_PR
{"data":{"viewer":{"login":"stubuser"},"repository":{"pullRequest":
{"number":${pr_number},"title":"single","url":"https://github.com/acme/app/pull/${pr_number}","state":"${pr_state}","isDraft":false,"isCrossRepository":false,"mergeable":"MERGEABLE","mergeStateStatus":"CLEAN","author":{"login":"stubuser"},"headRefName":"feat/single","baseRefName":"main","baseRef":{"target":{"oid":"base1111111111111111111111111111111111111"}},"repository":{"nameWithOwner":"acme/app"},"comments":{"nodes":[]},"reviews":{"nodes":[]},"reviewThreads":{"nodes":[]},"commits":{"nodes":[{"commit":{"oid":"head9999999999999999999999999999999999999","statusCheckRollup":null}}]}}
}}}
GRAPHQL_ONE_PR
  echo "200"
  exit 0
fi

# One PullRequest per case the filter has to get right — same fixture data as
# tests/lib/stubs/gh's graphql branch, kept in sync by hand since the two stubs
# serve the same script from two different transports.
#   #1 viewer's, mixed checks — FAILURE + QUEUED + SKIPPED. Only the
#      FAILURE is a failing check; a queued run is pending, not failing.
#   #2 a bot's — kept by default.
#   #3 another human's — dropped unless --all-authors.
#   #4 viewer's but a draft — dropped unless --include-drafts.
#   #5 viewer's but from a fork — dropped unless --include-forks.
#   #6 viewer's, conflicting, StatusContext checks (FAILURE + PENDING) and
#      two unresolved review threads; a third thread is resolved and a
#      fourth outdated, so neither counts.
search_fixture=$(cat <<'GRAPHQL_FIXTURE'
{"data":{"viewer":{"login":"stubuser"},"search":{"issueCount":6,"nodes":[
{"number":1,"title":"mixed checks","url":"https://github.com/acme/app/pull/1","state":"OPEN","isDraft":false,"isCrossRepository":false,"mergeable":"MERGEABLE","mergeStateStatus":"BLOCKED","author":{"login":"stubuser"},"headRefName":"feat/one","baseRefName":"main","baseRef":{"target":{"oid":"base1111111111111111111111111111111111111"}},"repository":{"nameWithOwner":"acme/app"},"comments":{"nodes":[{"databaseId":11,"body":"please fix"},{"databaseId":12,"body":"[babysitter] Fixed — bumped the timeout."}]},"reviews":{"nodes":[{"databaseId":21,"state":"CHANGES_REQUESTED"}]},"reviewThreads":{"nodes":[{"isResolved":false,"isOutdated":false,"comments":{"nodes":[{"databaseId":31,"body":"this leaks"},{"databaseId":32,"body":"[babysitter] Fixed — closed the handle."}]}}]},"commits":{"nodes":[{"commit":{"oid":"head1111111111111111111111111111111111111","statusCheckRollup":{"state":"FAILURE","contexts":{"nodes":[
  {"__typename":"CheckRun","name":"test","conclusion":"FAILURE"},
  {"__typename":"CheckRun","name":"build","conclusion":null},
  {"__typename":"CheckRun","name":"lint","conclusion":"SKIPPED"}]}}}}]}},
{"number":2,"title":"bump dep","url":"https://github.com/acme/app/pull/2","state":"OPEN","isDraft":false,"isCrossRepository":false,"mergeable":"MERGEABLE","mergeStateStatus":"CLEAN","author":{"login":"dependabot[bot]"},"headRefName":"dependabot/npm/x","baseRefName":"main","baseRef":{"target":{"oid":"base1111111111111111111111111111111111111"}},"repository":{"nameWithOwner":"acme/app"},"comments":{"nodes":[]},"reviews":{"nodes":[]},"reviewThreads":{"nodes":[]},"commits":{"nodes":[{"commit":{"oid":"head2222222222222222222222222222222222222","statusCheckRollup":{"state":"SUCCESS","contexts":{"nodes":[
  {"__typename":"CheckRun","name":"test","conclusion":"SUCCESS"}]}}}}]}},
{"number":3,"title":"someone else","url":"https://github.com/acme/app/pull/3","state":"OPEN","isDraft":false,"isCrossRepository":false,"mergeable":"MERGEABLE","mergeStateStatus":"CLEAN","author":{"login":"otherhuman"},"headRefName":"feat/three","baseRefName":"main","baseRef":{"target":{"oid":"base1111111111111111111111111111111111111"}},"repository":{"nameWithOwner":"acme/app"},"comments":{"nodes":[]},"reviews":{"nodes":[]},"reviewThreads":{"nodes":[]},"commits":{"nodes":[{"commit":{"oid":"head3333333333333333333333333333333333333","statusCheckRollup":null}}]}},
{"number":4,"title":"still drafting","url":"https://github.com/acme/app/pull/4","state":"OPEN","isDraft":true,"isCrossRepository":false,"mergeable":"MERGEABLE","mergeStateStatus":"DRAFT","author":{"login":"stubuser"},"headRefName":"feat/four","baseRefName":"main","baseRef":{"target":{"oid":"base1111111111111111111111111111111111111"}},"repository":{"nameWithOwner":"acme/app"},"comments":{"nodes":[]},"reviews":{"nodes":[]},"reviewThreads":{"nodes":[]},"commits":{"nodes":[{"commit":{"oid":"head4444444444444444444444444444444444444","statusCheckRollup":null}}]}},
{"number":5,"title":"from a fork","url":"https://github.com/acme/lib/pull/5","state":"OPEN","isDraft":false,"isCrossRepository":true,"mergeable":"MERGEABLE","mergeStateStatus":"CLEAN","author":{"login":"stubuser"},"headRefName":"feat/five","baseRefName":"main","baseRef":{"target":{"oid":"base2222222222222222222222222222222222222"}},"repository":{"nameWithOwner":"acme/lib"},"comments":{"nodes":[]},"reviews":{"nodes":[]},"reviewThreads":{"nodes":[]},"commits":{"nodes":[{"commit":{"oid":"head5555555555555555555555555555555555555","statusCheckRollup":null}}]}},
{"number":6,"title":"conflicting","url":"https://github.com/acme/lib/pull/6","state":"OPEN","isDraft":false,"isCrossRepository":false,"mergeable":"CONFLICTING","mergeStateStatus":"DIRTY","author":{"login":"stubuser"},"headRefName":"feat/six","baseRefName":"main","baseRef":{"target":{"oid":"base2222222222222222222222222222222222222"}},"repository":{"nameWithOwner":"acme/lib"},"comments":{"nodes":[{"databaseId":61,"body":"human comment"}]},"reviews":{"nodes":[{"databaseId":62,"state":"COMMENTED"}]},"reviewThreads":{"nodes":[
  {"isResolved":false,"isOutdated":false,"comments":{"nodes":[{"databaseId":63,"body":"human comment"}]}},
  {"isResolved":false,"isOutdated":false,"comments":{"nodes":[{"databaseId":64,"body":"human comment"}]}},
  {"isResolved":true,"isOutdated":false,"comments":{"nodes":[{"databaseId":65,"body":"human comment"}]}},
  {"isResolved":false,"isOutdated":true,"comments":{"nodes":[{"databaseId":66,"body":"human comment"}]}}]},"commits":{"nodes":[{"commit":{"oid":"head6666666666666666666666666666666666666","statusCheckRollup":{"state":"FAILURE","contexts":{"nodes":[
  {"__typename":"StatusContext","context":"ci/legacy","state":"FAILURE"},
  {"__typename":"StatusContext","context":"ci/pending","state":"PENDING"}]}}}}]}}
]}}}
GRAPHQL_FIXTURE
)

# Honour the search qualifier the script built, so a --repo sweep fixture is
# actually scoped rather than passing because the stub ignored the scope.
# issueCount is recomputed so the truncation warning stays consistent.
case "$q_val" in
repo:*)
  want=${q_val#repo:}
  want=${want%% *}
  printf '%s' "$search_fixture" | jq -c --arg want "$want" '
    .data.search.nodes |= map(select(.repository.nameWithOwner == $want))
    | .data.search.issueCount = (.data.search.nodes | length)' >"$out_file"
  ;;
*)
  printf '%s' "$search_fixture" >"$out_file"
  ;;
esac
echo "200"
