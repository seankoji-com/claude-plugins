# Project-local npm config. Committed on purpose — it contains no secret.
#
# The @seankoji scope lives on GitHub Packages, not npmjs. Without this mapping npm
# resolves @seankoji/... against registry.npmjs.org and returns a bare 404 that reads
# as "this package does not exist" rather than "you are asking the wrong registry" —
# which is exactly how the first install attempt of
# @seankoji/claude-plugins-opencode failed.
@seankoji:registry=https://npm.pkg.github.com

# Auth by environment variable, never a literal token. npm expands ${VAR} in .npmrc at
# read time, so the credential stays out of the repo and out of shell history while the
# mapping above stays shareable.
#
#   export NODE_AUTH_TOKEN=<classic PAT with read:packages, and nothing else>
#
# It must be a CLASSIC token: GitHub's npm-registry docs state "GitHub Packages only
# supports authentication using a personal access token (classic)". Fine-grained tokens
# expose a Packages permission that works against other GitHub Packages registries but
# not this one.
#
# GitHub Actions needs no export — actions/setup-node writes its own ~/.npmrc from
# `registry-url`, and .github/workflows/release.yml passes NODE_AUTH_TOKEN explicitly.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
